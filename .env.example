DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

SECRET_KEY=change-this-in-production-use-random-string-here

HMAC_SECRET=your-random-32-byte-hex-string-here
INTERNAL_API_KEY=shared-secret-nextjs-uses-to-call-django
DOCUMENT_ENCRYPTION_KEY=your-64-char-hex-string-for-aes-256-gcm

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

AI_PHOTOS_YOLO_MODEL_PATH=models/best.pt
AI_PHOTOS_YOLO_CONF=0.05
AI_PHOTOS_YOLO_IOU=0.50
AI_PHOTOS_YOLO_MAX_DET=50
AI_PHOTOS_YOLO_IMGSZ=1280
AI_PHOTOS_OCR_CONF=0.50
AI_PHOTOS_UPSCALE_FACTOR=3
AI_PHOTOS_CROP_PADDING_RATIO=0.04
AI_PHOTOS_AUTO_CONFIDENCE=0.85
AI_PHOTOS_REVIEW_CONFIDENCE=0.50

# ── HitPay payment gateway ───────────────────────────────────
# Sandbox base URL; switch to https://api.hit-pay.com/v1 in production.
HITPAY_API_URL=https://api.sandbox.hit-pay.com/v1
# Business API key from HitPay Dashboard -> Settings -> Payment Gateway.
HITPAY_API_KEY=
# Per-endpoint webhook salt from Dashboard -> Developers -> Webhooks
# (NOT the legacy API-key salt).
HITPAY_WEBHOOK_SALT=
# Optional: comma-separated HitPay rails to force instead of the merchant
# Dashboard's toggled-on set. Leave unset/empty for default behaviour.
# Example (sandbox-supported rails):
# HITPAY_PAYMENT_METHODS=grabpay_direct,shopee_pay,atome

# ── Payment reconcile cron ───────────────────────────────────
# Poll HitPay for pending payments older than 15 minutes every 15 min:
#   */15 * * * * cd /app && python manage.py reconcile_payments
