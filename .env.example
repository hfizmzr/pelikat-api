# ── Django core ──────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Internal service auth (X-Internal-Key header) ────────────
INTERNAL_API_KEY=

# ── Supabase (service-role; Django is stateless) ─────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── QR / document crypto ─────────────────────────────────────
HMAC_SECRET=
DOCUMENT_ENCRYPTION_KEY=

# ── HitPay payment gateway ───────────────────────────────────
# Sandbox base URL; switch to https://api.hit-pay.com/v1 in production.
HITPAY_API_URL=https://api.sandbox.hit-pay.com/v1
# Business API key from HitPay Dashboard -> Settings -> Payment Gateway.
HITPAY_API_KEY=
# Per-endpoint webhook salt from Dashboard -> Developers -> Webhooks
# (NOT the legacy API-key salt).
HITPAY_WEBHOOK_SALT=

# ── AI photos (optional overrides) ───────────────────────────
# AI_PHOTOS_YOLO_MODEL_PATH=
# AI_PHOTOS_YOLO_CONF=0.05
# AI_PHOTOS_YOLO_IOU=0.50
# AI_PHOTOS_YOLO_MAX_DET=50
# AI_PHOTOS_YOLO_IMGSZ=1280
# AI_PHOTOS_OCR_CONF=0.50
# AI_PHOTOS_UPSCALE_FACTOR=3
# AI_PHOTOS_CROP_PADDING_RATIO=0.04
# AI_PHOTOS_AUTO_CONFIDENCE=0.85
# AI_PHOTOS_REVIEW_CONFIDENCE=0.50

# ── Payment reconcile cron ───────────────────────────────────
# Poll HitPay for pending payments older than 15 minutes every 15 min:
#   */15 * * * * cd /app && python manage.py reconcile_payments
