FROM python:3.11-slim

WORKDIR /app

# No torch/paddle runtime needed: the YOLO bib detector runs from the
# committed ONNX export via onnxruntime, and OCR runs RapidOCR PP-OCRv5
# mobile ONNX models bundled under models/rapidocr/. Thread caps stop the
# ONNX thread pools fighting gunicorn's 4 workers for CPU (the caps are
# harmless in dev, critical on the multi-worker server).
ENV OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    MKL_NUM_THREADS=2

RUN apt-get update && apt-get install -y \
    libgl1 libglib2.0-0 libgomp1 \
    libfreetype6-dev fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY pelikat/ ./pelikat/
COPY apps/ ./apps/
# best.onnx (bib detector) + bundled RapidOCR PP-OCRv5 models — everything
# inference needs ships with the image, no model downloads at runtime
COPY models/ ./models/
COPY manage.py .

RUN python manage.py collectstatic --noinput || true

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "120", "pelikat.wsgi:application"]
